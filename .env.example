# 타코 · 인스레드 치트키 (TAKOH Studio Browser) 환경 변수 예시 파일
# 실제 키와 경로는 이 파일이 아닌 .env 파일 또는 앱 내 [연결·설정] 탭에 저장하세요. (.env 파일은 Git에 커밋되지 않습니다)

# 1. 전용 브라우저 도우미 서버 포트 (기본: 5006 / Chrome 확장 도우미: 5005)
TAKOH_STUDIO_PORT=5006

# 2. Python 실행 파일 경로 지정 (미지정 시 내장 탐색기로 자동 감지)
# TAKOH_PYTHON=C:\Python312\python.exe

# 3. AI 분석 및 대본 작성용 API 키 (선택 — 앱 내 설정 탭에서도 등록 가능)
# GEMINI_API_KEY=your_gemini_api_key_here

# 4. 쇼핑 쇼츠·상품 발굴용 검색 API 키 (선택)
# YOUTUBE_API_KEY=your_youtube_data_api_key_here
# SERPAPI_API_KEY=your_serpapi_key_here

# 5. 제휴 링크 자동 발급용 API 키 (선택)
# COUPANG_ACCESS_KEY=your_coupang_access_key_here
# COUPANG_SECRET_KEY=your_coupang_secret_key_here
